{
  "name": "focus-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:questions": "node scripts/sync-advanced-questions.mjs",
    "predev": "npm run sync:questions",
    "dev": "vite",
    "prebuild": "npm run sync:questions",
    "build": "npm run typecheck && npm run verify:ledger && npm run verify:questions && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:ledger": "node scripts/verify-ziwei-ledger.mjs",
