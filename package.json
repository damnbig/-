    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
